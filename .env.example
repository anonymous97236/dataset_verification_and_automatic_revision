# Gemini 3.5 Flash (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Qwen3.5 27B: first serve Qwen with an OpenAI-compatible engine such as
# Unsloth or vLLM. Then enter that server's URL and the served model name below.
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_MODEL=Qwen3.5-27B-UD-Q4_K_XL
# Set to true only when the server supports Qwen's chat_template_kwargs option.
QWEN_ENABLE_THINKING=false

# Optional defaults shared by both providers.
LLM_TEMPERATURE=1.0
LLM_TIMEOUT_SECONDS=180
